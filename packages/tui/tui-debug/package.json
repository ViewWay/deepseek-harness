{
  "name": "@deepseek-ai/dsh-tui-debug",
  "description": "Terminal debug panels, commands, source preview, and the $EDITOR handoff over the in-process ctx.debug seam",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/tui/tui-debug"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-debug": "workspace:*",
    "@deepseek-ai/dsh-terminal": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-debug": "workspace:*",
    "@deepseek-ai/dsh-debug-fixture": "workspace:*",
    "@deepseek-ai/dsh-terminal": "workspace:*"
  }
}

{
  "name": "@deepseek-ai/dsh-debug-adapter-manager",
  "description": "Managed debug-adapter service (ctx.debugAdapters) for the DeepSeek Harness — validated adapter manifests with per-platform SHA-256 records, atomic managed install with checksum verification and self-test rollback, concurrent-install sharing, override-free resolution, and install lifecycle events",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/debug/debug-adapter-manager"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-debug": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-debug": "workspace:*"
  }
}

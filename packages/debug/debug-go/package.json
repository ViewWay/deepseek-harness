{
  "name": "@deepseek-ai/dsh-debug-go",
  "description": "Go debug provider registering on ctx.debug: launch and attach resolution into the frozen plan shapes with delve mode and flag validation, plus the verified delve v1.27.2 adapter manifest with GitHub-published SHA-256 digests",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/debug/debug-go"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-debug": "workspace:*",
    "@deepseek-ai/dsh-debug-adapter-manager": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-debug": "workspace:*",
    "@deepseek-ai/dsh-debug-adapter-manager": "workspace:*",
    "@deepseek-ai/dsh-debug-fixture": "workspace:*"
  }
}
